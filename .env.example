# 复制为 .env 后按本机情况填写；不要把真实 .env 提交到 Git（.gitignore 已排除）
# 无真实值的模板，允许入库（ADR-0002 / F04）

# ---- 运行环境 ----
NODE_ENV=development
# API 监听端口（前端开发服务器会把 /api 代理到这里）
API_PORT=3001
# 浏览器访问的同源地址；生产换成正式域名（CORS/CSRF 校验用）
PUBLIC_ORIGIN=http://127.0.0.1:5173
# 前端开发服务器端口
WEB_PORT=5173

# ---- 数据库 ----
# 开发：项目内隔离实例（scripts/dev-db.ps1 启动，端口 55432）
# 本机正式：native init生成独立库/应用角色和受限runtime配置；不使用Docker
DATABASE_URL=postgresql://aiwb:CHANGE_ME_LOCAL_ONLY@127.0.0.1:55432/aiwb_dev?schema=public
# 迁移/集成测试使用独立库，避免污染开发数据
DATABASE_URL_TEST=postgresql://aiwb:CHANGE_ME_LOCAL_ONLY@127.0.0.1:55432/aiwb_test?schema=public

# ---- 会话与安全 ----
SESSION_COOKIE_NAME=sfs_session
# 会话空闲/绝对过期（分钟、小时）
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_DAYS=7
# 生产 HTTPS 置为 true；开发 http://127.0.0.1 必须为 false
COOKIE_SECURE=false
# 登录与搜索限流（每分钟次数）
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60

# ---- 后台任务 ----
# 导出/导入临时卷（必须是持久目录且不进 Git）
TRANSFER_STORAGE_DIR=.data/transfers
WORKER_POLL_INTERVAL_MS=5000

# ---- 日志 ----
LOG_LEVEL=info
# 生产不对公网开放 API 文档
ENABLE_API_DOCS=false

# ---- 备份（生产填写；开发留空）----
BACKUP_DIR=
BACKUP_AGE_RECIPIENT=

