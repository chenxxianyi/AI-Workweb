{
  "name": "@aiwb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 编程工作台后端 API（NestJS）",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:pipeline": "tsx --tsconfig tsconfig.test.json test/pipeline-check.ts",
    "test:auth": "tsx --tsconfig tsconfig.test.json test/auth-check.ts",
    "test:auth-http": "tsx --tsconfig tsconfig.test.json test/auth-http-check.ts",
    "test:session": "tsx --tsconfig tsconfig.test.json test/session-check.ts",
    "test:workspace": "tsx --tsconfig tsconfig.test.json test/workspace-check.ts",
    "auth:bootstrap": "tsx src/cli/bootstrap-owner.ts",
    "auth:recover": "tsx src/cli/recover-account.ts",
    "auth:calibrate": "tsx src/cli/password-calibrate.ts"
  },
  "dependencies": {
    "@aiwb/contracts": "workspace:*",
    "@aiwb/domain": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
